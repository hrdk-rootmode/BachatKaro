# ═══════════════════════════════════════════════════════════════════════════
# DEALHUNT BACKEND - PRODUCTION CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════

# ═══════════════════════════════════════════════
# APPLICATION SETTINGS
# ═══════════════════════════════════════════════
APP_NAME=DealHunt
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=your-super-secret-key-change-in-production-minimum-32-characters-required
API_V1_PREFIX=/api/v1
ALLOWED_ORIGINS=http://localhost:3000,https://dealhunt.app

# ═══════════════════════════════════════════════
# DATABASE (PostgreSQL with Async Support)
# ═══════════════════════════════════════════════
# Format: postgresql+asyncpg://user:password@host:port/database
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dealhunt
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40

# ═══════════════════════════════════════════════
# REDIS CACHE
# ═══════════════════════════════════════════════
# Keep your password from old config
REDIS_URL=redis://default:password@host:6379/0
REDIS_MAX_CONNECTIONS=50

# ═══════════════════════════════════════════════
# FIREBASE AUTHENTICATION
# ═══════════════════════════════════════════════
# Option 1: Use JSON file (RECOMMENDED - More Secure)
FIREBASE_CREDENTIALS_PATH=/path/to/firebase-adminsdk.json
FIREBASE_PROJECT_ID=your-project-id

FIREBASE_CREDENTIALS='{}'
# Option 2: Keep your old inline format (if you prefer)
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# ═══════════════════════════════════════════════
# GROQ AI (4 Accounts for 4x Quota = 57,600 requests/day)
# ═══════════════════════════════════════════════
# Main account: Daily scraping + product analysis
GROQ_API_KEY_MAIN=gsk_your_main_groq_key_here
# Search account: Real-time URL searches
GROQ_API_KEY_SEARCH=gsk_your_search_groq_key_here
# Healing account: Self-healing scraper fallback
GROQ_API_KEY_HEALING=gsk_your_healing_groq_key_here
# Chat account: Premium AI chat feature
GROQ_API_KEY_CHAT=gsk_your_chat_groq_key_here

GROQ_MODEL=llama-3.1-8b-instant
GROQ_DAILY_LIMIT=14400

# ═══════════════════════════════════════════════
# GEMINI AI (Premium Feature Fallback - Optional)
# ═══════════════════════════════════════════════
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxx

# ═══════════════════════════════════════════════
# GOOGLE PLAY BILLING (Android Payments)
# ═══════════════════════════════════════════════

# Mock mode - works without real credentials (for development)
GOOGLE_PLAY_MOCK_MODE=true

# Enable/disable Google Play billing
GOOGLE_PLAY_ENABLED=true

# Your app's package name (from Play Console)
GOOGLE_PLAY_PACKAGE_NAME=com.dealhunt.app

# Path to service account JSON file (from Google Cloud Console)
# Create one at: https://console.cloud.google.com/iam-admin/serviceaccounts
GOOGLE_APPLICATION_CREDENTIALS=/path/to/google-play-service-account.json

# Subscription Product SKUs (must match Play Console products)
GOOGLE_PLAY_PRO_SKU=dealhunt_pro_monthly
GOOGLE_PLAY_PREMIUM_SKU=dealhunt_premium_monthly

# ═══════════════════════════════════════════════
# RAZORPAY (Web Payments) - UPDATED
# ═══════════════════════════════════════════════

# Enable/disable Razorpay
RAZORPAY_ENABLED=true

# Razorpay credentials
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
# ═══════════════════════════════════════════════
# AFFILIATE LINKS (Merged from both configs)
# ═══════════════════════════════════════════════
# Amazon India
AMAZON_AFFILIATE_TAG=dealhunt-21

# Flipkart
FLIPKART_AFFILIATE_ID=affiliate123

# Meesho
MEESHO_AFFILIATE_ID=dealhunt

# Croma (from your old config)
AFFILIATE_CROMA_ID=croma_affiliate

# Myntra (from your old config)
AFFILIATE_MYNTRA_ID=myntra_affiliate

# ═══════════════════════════════════════════════
# ADMOB ADS (From your old config - Frontend uses these)
# ═══════════════════════════════════════════════
ADMOB_APP_ID=ca-app-pub-xxxxxxxxxxxxxxxx~xxxxxxxxxx
ADMOB_BANNER_ID=ca-app-pub-xxxxxxxxxxxxxxxx/xxxxxxxxxx
ADMOB_INTERSTITIAL_ID=ca-app-pub-xxxxxxxxxxxxxxxx/xxxxxxxxxx
ADMOB_REWARDED_ID=ca-app-pub-xxxxxxxxxxxxxxxx/xxxxxxxxxx

# ═══════════════════════════════════════════════
# FIREBASE CLOUD MESSAGING (Push Notifications)
# ═══════════════════════════════════════════════
FCM_SERVER_KEY=xxxxxxxxxxxxxxxxxxxxx
ENABLE_PUSH_NOTIFICATIONS=True

# ═══════════════════════════════════════════════
# GITHUB BACKUP (Price History Archival)
# ═══════════════════════════════════════════════
GITHUB_TOKEN=ghp_your_github_token_here
GITHUB_REPO=username/dealhunt-scraper
GITHUB_BRANCH=main
ARCHIVE_TO_GIT=True

# ═══════════════════════════════════════════════
# RATE LIMITING (Anti-Abuse)
# ═══════════════════════════════════════════════
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# ═══════════════════════════════════════════════
# PLAYWRIGHT SCRAPING SETTINGS
# ═══════════════════════════════════════════════
PLAYWRIGHT_HEADLESS=True
SCRAPER_TIMEOUT=30000
SCRAPER_MAX_RETRIES=3
SCRAPER_CONCURRENT_LIMIT=10
SCRAPE_DELAY=2000
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36

# ═══════════════════════════════════════════════
# DATA RETENTION & CLEANUP
# ═══════════════════════════════════════════════
PRICE_HISTORY_DAYS=120
DATA_RETENTION_MONTHS=6

# ═══════════════════════════════════════════════
# SECURITY KEYS (Merged from both)
# ═══════════════════════════════════════════════
# Used for CRON job authentication
CRON_SECRET=your_cron_secret_key


ADMIN_EMAILS=your@email.com
# Used for admin panel access
ADMIN_SECRET=your_admin_secret_key

# Used for JWT token generation (if not using Firebase)
JWT_SECRET=your_jwt_secret_for_tokens

# ═══════════════════════════════════════════════
# SUBSCRIPTION PLANS (Database-driven, these are defaults)
# ═══════════════════════════════════════════════
# FREE PLAN
PLAN_FREE_SEARCHES=10
PLAN_FREE_WISHLIST=5

# PRO PLAN (₹49/month)
PLAN_PRO_PRICE=4900
PLAN_PRO_DURATION_DAYS=30
PLAN_PRO_SEARCHES=100
PLAN_PRO_WISHLIST=50

# PREMIUM PLAN (₹149/month)
PLAN_PREMIUM_PRICE=14900
PLAN_PREMIUM_DURATION_DAYS=30
PLAN_PREMIUM_SEARCHES=-1
PLAN_PREMIUM_WISHLIST=-1

# Ad Reward Bonuses
REWARD_AD_BONUS_SEARCHES=5

# ═══════════════════════════════════════════════
# JOB SCHEDULER
# ═══════════════════════════════════════════════
ENABLE_SCHEDULER=True
DAILY_SCRAPE_HOUR=2
TRENDING_CACHE_HOUR=5
ALERT_CHECK_INTERVAL_HOURS=6

# Scheduler Branch Control
# Options: "current" (use current branch), "stable", "main", or any branch name
SCHEDULER_BRANCH=current

# Error Notifications (Optional - requires SMTP setup)
ENABLE_ERROR_NOTIFICATIONS=False
ERROR_NOTIFICATION_EMAIL=your-email@example.com

# SMTP Settings (for error notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=True
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=DealHunt Scheduler <scheduler@dealhunt.com>

# ═══════════════════════════════════════════════
# MONITORING (Optional - for Production)
# ═══════════════════════════════════════════════
SENTRY_DSN=https://xxxxxxxxxxxxx@sentry.io/xxxxx
LOG_LEVEL=INFO

# ═══════════════════════════════════════════════
# LEGACY SETTINGS (From old config - keep for compatibility)
# ═══════════════════════════════════════════════
NODE_ENV=development
PORT=3000
USE_BROWSER=false
PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true