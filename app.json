{
  "expo": {
    "name": "DealHunt",
    "slug": "dealhunt-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/deal.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "dealhunt",
    "splash": {
      "image": "./assets/deal.png",
      "resizeMode": "contain",
      "backgroundColor": "#FF6B35"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dealhunt.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/deal.png",
        "backgroundColor": "#FF6B35"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.dealhunt.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "your-project-id"
      }
    }
  }
}